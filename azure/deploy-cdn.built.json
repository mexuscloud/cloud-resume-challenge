{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "11465576331290513573"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "global",
      "metadata": {
        "description": "Front Door uses global location"
      }
    },
    "origin_hostname": {
      "type": "string",
      "metadata": {
        "description": "Origin hostname (e.g. mystorage.z13.web.core.windows.net)"
      }
    },
    "domain_fqdn": {
      "type": "string",
      "metadata": {
        "description": "WWW custom domain"
      }
    },
    "apex_fqdn": {
      "type": "string",
      "metadata": {
        "description": "Apex/root domain"
      }
    },
    "dns_zone_name": {
      "type": "string",
      "metadata": {
        "description": "Azure DNS zone name"
      }
    },
    "dns_zone_rg": {
      "type": "string",
      "metadata": {
        "description": "Resource group where DNS zone exists"
      }
    },
    "fd_profile_name": {
      "type": "string",
      "defaultValue": "fd-profile-crc",
      "metadata": {
        "description": "Stable Front Door profile name"
      }
    },
    "fd_endpoint_name": {
      "type": "string",
      "defaultValue": "fd-endpoint-crc",
      "metadata": {
        "description": "Stable Front Door endpoint name"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Cdn/profiles",
      "apiVersion": "2021-06-01",
      "name": "[parameters('fd_profile_name')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_AzureFrontDoor"
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints",
      "apiVersion": "2021-06-01",
      "name": "[format('{0}/{1}', parameters('fd_profile_name'), parameters('fd_endpoint_name'))]",
      "location": "[parameters('location')]",
      "properties": {
        "enabledState": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', parameters('fd_profile_name'))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups",
      "apiVersion": "2021-06-01",
      "name": "[format('{0}/{1}', parameters('fd_profile_name'), 'og-static')]",
      "properties": {
        "healthProbeSettings": {
          "probePath": "/index.html",
          "probeProtocol": "Https",
          "probeRequestType": "GET",
          "probeIntervalInSeconds": 120
        },
        "loadBalancingSettings": {
          "sampleSize": 4,
          "successfulSamplesRequired": 2
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', parameters('fd_profile_name'))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups/origins",
      "apiVersion": "2021-06-01",
      "name": "[format('{0}/{1}/{2}', parameters('fd_profile_name'), 'og-static', 'origin-static-web')]",
      "properties": {
        "hostName": "[parameters('origin_hostname')]",
        "originHostHeader": "[parameters('origin_hostname')]",
        "httpPort": 80,
        "httpsPort": 443,
        "priority": 1,
        "weight": 1000
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/originGroups', parameters('fd_profile_name'), 'og-static')]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/customDomains",
      "apiVersion": "2021-06-01",
      "name": "[format('{0}/{1}', parameters('fd_profile_name'), 'cd-www')]",
      "properties": {
        "hostName": "[parameters('domain_fqdn')]",
        "azureDnsZone": {
          "id": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('dns_zone_rg')), 'Microsoft.Network/dnsZones', parameters('dns_zone_name'))]"
        },
        "tlsSettings": {
          "certificateType": "ManagedCertificate",
          "minimumTlsVersion": "TLS12"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', parameters('fd_profile_name'))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/customDomains",
      "apiVersion": "2021-06-01",
      "name": "[format('{0}/{1}', parameters('fd_profile_name'), 'cd-apex')]",
      "properties": {
        "hostName": "[parameters('apex_fqdn')]",
        "azureDnsZone": {
          "id": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('dns_zone_rg')), 'Microsoft.Network/dnsZones', parameters('dns_zone_name'))]"
        },
        "tlsSettings": {
          "certificateType": "ManagedCertificate",
          "minimumTlsVersion": "TLS12"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', parameters('fd_profile_name'))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints/routes",
      "apiVersion": "2021-06-01",
      "name": "[format('{0}/{1}/{2}', parameters('fd_profile_name'), parameters('fd_endpoint_name'), 'route-www')]",
      "properties": {
        "originGroup": {
          "id": "[resourceId('Microsoft.Cdn/profiles/originGroups', parameters('fd_profile_name'), 'og-static')]"
        },
        "supportedProtocols": [
          "Http",
          "Https"
        ],
        "httpsRedirect": "Enabled",
        "linkToDefaultDomain": "Enabled",
        "patternsToMatch": [
          "/*"
        ],
        "forwardingProtocol": "MatchRequest",
        "enabledState": "Enabled",
        "customDomains": [
          {
            "id": "[resourceId('Microsoft.Cdn/profiles/customDomains', parameters('fd_profile_name'), 'cd-www')]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', parameters('fd_profile_name'), parameters('fd_endpoint_name'))]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups', parameters('fd_profile_name'), 'og-static')]",
        "[resourceId('Microsoft.Cdn/profiles/customDomains', parameters('fd_profile_name'), 'cd-www')]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints/routes",
      "apiVersion": "2021-06-01",
      "name": "[format('{0}/{1}/{2}', parameters('fd_profile_name'), parameters('fd_endpoint_name'), 'route-apex')]",
      "properties": {
        "originGroup": {
          "id": "[resourceId('Microsoft.Cdn/profiles/originGroups', parameters('fd_profile_name'), 'og-static')]"
        },
        "supportedProtocols": [
          "Http",
          "Https"
        ],
        "patternsToMatch": [
          "/*"
        ],
        "forwardingProtocol": "MatchRequest",
        "enabledState": "Enabled",
        "customDomains": [
          {
            "id": "[resourceId('Microsoft.Cdn/profiles/customDomains', parameters('fd_profile_name'), 'cd-apex')]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/customDomains', parameters('fd_profile_name'), 'cd-apex')]",
        "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', parameters('fd_profile_name'), parameters('fd_endpoint_name'))]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups', parameters('fd_profile_name'), 'og-static')]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/ruleSets",
      "apiVersion": "2025-04-15",
      "name": "[format('{0}/{1}', parameters('fd_profile_name'), 'rsApexRedirect')]",
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', parameters('fd_profile_name'))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/ruleSets/rules",
      "apiVersion": "2025-04-15",
      "name": "[format('{0}/{1}/{2}', parameters('fd_profile_name'), 'rsApexRedirect', 'redirectToWww')]",
      "properties": {
        "order": 1,
        "actions": [
          {
            "name": "UrlRedirect",
            "parameters": {
              "redirectType": "Moved",
              "destinationProtocol": "Https",
              "customHostname": "[parameters('domain_fqdn')]",
              "typeName": "DeliveryRuleUrlRedirectActionParameters"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/ruleSets', parameters('fd_profile_name'), 'rsApexRedirect')]"
      ]
    }
  ],
  "outputs": {
    "afd_endpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Cdn/profiles/afdEndpoints', parameters('fd_profile_name'), parameters('fd_endpoint_name')), '2021-06-01').hostName]"
    },
    "afd_profile_name": {
      "type": "string",
      "value": "[parameters('fd_profile_name')]"
    },
    "afd_endpoint_id": {
      "type": "string",
      "value": "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', parameters('fd_profile_name'), parameters('fd_endpoint_name'))]"
    }
  }
}